<!DOCTYPE html>
<html lang="ru" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Архив наших 6 месяцев — Ваня & Наташа</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --bg-deep: #0f0806;
      --bg-warm: #170d09;
      --glass-bg: rgba(32, 19, 13, 0.62);
      --glass-border: rgba(251, 191, 36, 0.16);
      --glass-border-hover: rgba(251, 191, 36, 0.42);
    }

    body {
      background-color: var(--bg-deep);
      background-image:
        radial-gradient(circle at 12% 18%, rgba(245, 158, 11, 0.12) 0%, transparent 45%),
        radial-gradient(circle at 88% 28%, rgba(234, 88, 12, 0.10) 0%, transparent 50%),
        radial-gradient(circle at 50% 85%, rgba(251, 191, 36, 0.08) 0%, transparent 60%),
        linear-gradient(180deg, #0d0604 0%, #160d09 50%, #0f0705 100%);
      color: #fdf8f5;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
    }

    .glass-card {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      box-shadow:
        0 20px 50px rgba(5, 2, 1, 0.7),
        inset 0 1px 1px rgba(255, 235, 200, 0.08);
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .glass-card:hover {
      border-color: var(--glass-border-hover);
      box-shadow:
        0 24px 60px rgba(0, 0, 0, 0.8),
        0 0 35px rgba(245, 158, 11, 0.1),
        inset 0 1px 1px rgba(255, 235, 200, 0.15);
    }

    .intimate-aura {
      background: linear-gradient(145deg, rgba(45, 16, 18, 0.72), rgba(22, 10, 9, 0.88));
      border: 1px solid rgba(251, 146, 60, 0.28);
      box-shadow:
        0 0 90px -15px rgba(234, 88, 12, 0.25),
        0 25px 60px rgba(5, 2, 1, 0.9),
        inset 0 0 40px rgba(245, 158, 11, 0.06);
    }

    .warm-aura {
      box-shadow:
        0 0 90px -10px rgba(245, 158, 11, 0.2),
        0 25px 60px rgba(5, 2, 1, 0.85),
        inset 0 0 30px rgba(251, 191, 36, 0.06);
    }

    .reveal {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* 3D Flip Cards */
    .flip-card {
      perspective: 1200px;
      height: 265px;
      cursor: pointer;
    }

    .flip-card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      text-align: center;
      transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform-style: preserve-3d;
    }

    @media (hover: hover) and (pointer: fine) {
      .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);
      }
    }

    .flip-card.is-flipped .flip-card-inner {
      transform: rotateY(180deg);
    }

    .flip-card-front,
    .flip-card-back {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      border-radius: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .flip-card-front {
      background: linear-gradient(145deg, rgba(43, 26, 18, 0.75), rgba(20, 11, 8, 0.88));
      backdrop-filter: blur(16px);
      border: 1px solid rgba(251, 191, 36, 0.18);
    }

    .flip-card-back {
      background: linear-gradient(145deg, rgba(68, 34, 16, 0.92), rgba(30, 15, 9, 0.96));
      backdrop-filter: blur(20px);
      border: 1px solid rgba(251, 191, 36, 0.45);
      transform: rotateY(180deg);
    }

    .text-amber-gradient {
      background: linear-gradient(135deg, #fff7ed 0%, #fde68a 45%, #f59e0b 85%, #ea580c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .choice-btn.active {
      border-color: rgba(251, 191, 36, 0.8);
      background: rgba(245, 158, 11, 0.22);
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.2);
    }

    .ambient-orb {
      position: fixed;
      border-radius: 9999px;
      filter: blur(100px);
      pointer-events: none;
      z-index: 0;
      opacity: 0.3;
      animation: floatOrb 15s ease-in-out infinite alternate;
    }

    @keyframes floatOrb {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(30px, -35px) scale(1.1); }
    }
  </style>
</head>
<body class="selection:bg-amber-500/30 selection:text-amber-200">

  <!-- Фоновые свечения -->
  <div class="ambient-orb w-96 h-96 bg-amber-500/20 top-10 -left-20"></div>
  <div class="ambient-orb w-[30rem] h-[30rem] bg-orange-600/15 top-1/3 -right-32" style="animation-delay: -6s;"></div>
  <div class="ambient-orb w-96 h-96 bg-yellow-500/15 bottom-10 left-1/3" style="animation-delay: -10s;"></div>

  <!-- Верхняя навигация -->
  <header class="sticky top-0 z-40 backdrop-blur-md bg-[#0d0604]/85 border-b border-amber-500/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-sm">
          💛
        </span>
        <span class="font-serif italic text-lg sm:text-xl tracking-wide text-amber-100/90">
          Ваня & Наташа • 6 месяцев
        </span>
      </div>

      <div class="hidden md:flex items-center gap-5 text-xs text-amber-200/70">
        <a href="#analytics" class="hover:text-amber-300 transition">Аналитика</a>
        <a href="#hall" class="hover:text-amber-300 transition">Зал Славы</a>
        <a href="#midnight" class="hover:text-amber-300 transition">После полуночи 🕯️</a>
        <a href="#future" class="hover:text-amber-300 transition">Будущее</a>
        <a href="#games" class="hover:text-amber-300 transition">Игры</a>
      </div>

      <div class="flex items-center gap-2.5">
        <span id="dataSourceBadge" class="hidden sm:inline-flex items-center gap-1.5 text-xs px-3 py-1 rounded-full bg-amber-950/60 border border-amber-500/20 text-amber-200/80">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="dataSourceText">Архив загружен</span>
        </span>

        <!-- Принимает ИЛИ result.json, ИЛИ сразу пачку из 60 файлов messages*.html -->
        <label for="fileInput" class="cursor-pointer inline-flex items-center gap-2 text-xs sm:text-sm font-medium px-3.5 py-1.5 rounded-full bg-gradient-to-r from-amber-500/20 to-orange-600/25 hover:from-amber-500/30 hover:to-orange-600/35 border border-amber-400/30 text-amber-100 transition-all shadow-sm">
          <span>📂 Загрузить JSON / HTML</span>
          <input id="fileInput" type="file" accept=".json,.html" multiple class="hidden" />
        </label>
      </div>
    </div>
  </header>

  <!-- Всплывающее уведомление -->
  <div id="toastMessage" class="fixed bottom-5 right-5 z-50 pointer-events-none opacity-0 translate-y-4 transition-all duration-300 glass-card px-4 py-3 rounded-2xl border border-amber-400/40 text-sm text-amber-100 flex items-center gap-2.5 shadow-2xl">
    <span id="toastIcon">✨</span>
    <span id="toastText">Готово</span>
  </div>

  <!-- Основной контент -->
  <main class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-24 space-y-24 sm:space-y-32">

    <!-- ==========================================
         1. HERO SECTION + РАСШИРЕННЫЕ МЕТРИКИ ЧАТА
         ========================================== -->
    <section class="reveal text-center pt-4 sm:pt-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card text-amber-300/90 text-xs sm:text-sm font-medium mb-6 tracking-wider uppercase">
        <span>🔥 Цифровая вселенная нашей пары</span>
      </div>

      <h1 class="font-serif font-bold text-4xl sm:text-6xl md:text-7xl tracking-tight text-amber-gradient leading-tight max-w-4xl mx-auto">
        Архив наших 6 месяцев
      </h1>

      <p class="mt-4 sm:mt-6 text-base sm:text-xl text-amber-100/75 max-w-2xl mx-auto font-normal leading-relaxed">
        От первых сообщений и спасённых оценок до ночных разговоров, общих мемов и планов на будущее.
      </p>

      <!-- 4 главных счетчика (с голосовыми и реакциями из JSON) -->
      <div class="mt-10 sm:mt-14 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto">
        <div class="glass-card rounded-3xl p-6 relative overflow-hidden">
          <p class="text-xs uppercase tracking-widest text-amber-200/60 font-medium">Дней вместе</p>
          <div class="mt-2 flex items-baseline justify-center gap-1">
            <span class="text-3xl sm:text-5xl font-bold text-amber-300">180</span>
            <span class="text-2xl sm:text-4xl font-bold text-amber-400">+</span>
          </div>
          <p class="mt-1.5 text-xs text-amber-100/60">Полгода тепла и заботы</p>
        </div>

        <div class="glass-card rounded-3xl p-6 relative overflow-hidden">
          <p class="text-xs uppercase tracking-widest text-amber-200/60 font-medium">Всего сообщений</p>
          <div class="mt-2 flex items-baseline justify-center">
            <span id="messagesCounter" class="text-3xl sm:text-5xl font-bold text-amber-gradient">0</span>
          </div>
          <p class="mt-1.5 text-xs text-amber-100/60">Написано друг другу</p>
        </div>

        <div class="glass-card rounded-3xl p-6 relative overflow-hidden">
          <p class="text-xs uppercase tracking-widest text-amber-200/60 font-medium">Голосовые и кружки</p>
          <div class="mt-2 flex items-baseline justify-center gap-1">
            <span id="voiceMinutesCounter" class="text-3xl sm:text-5xl font-bold text-orange-300">0</span>
            <span class="text-base sm:text-xl font-semibold text-orange-300/80">мин</span>
          </div>
          <p id="voiceCountSub" class="mt-1.5 text-xs text-amber-100/60">Любимого голоса в ушах</p>
        </div>

        <div class="glass-card rounded-3xl p-6 relative overflow-hidden">
          <p class="text-xs uppercase tracking-widest text-amber-200/60 font-medium">Реакций ❤️ и 🔥</p>
          <div class="mt-2 flex items-baseline justify-center">
            <span id="reactionsCounter" class="text-3xl sm:text-5xl font-bold text-amber-300">0</span>
          </div>
          <p class="mt-1.5 text-xs text-amber-100/60">Искр и тепла в чате</p>
        </div>
      </div>
    </section>

    <!-- ==========================================
         2. ДАТА-АНАЛИТИКА И СЛОВАРЬ НЕЖНОСТИ
         ========================================== -->
    <section id="analytics" class="space-y-8">
      <div class="reveal text-center max-w-2xl mx-auto">
        <span class="text-xs uppercase tracking-widest text-amber-400/80 font-semibold">Данные и доказательства</span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-amber-50 mt-1">
          Ритм нашего общения
        </h2>
        <p class="text-sm sm:text-base text-amber-100/65 mt-2">
          Кто пишет больше, когда наступает наш ночной прайм-тайм и какие слова звучат чаще всего
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
        <!-- График 1: Баланс сил -->
        <div class="reveal glass-card rounded-3xl p-6 sm:p-8 lg:col-span-5 flex flex-col justify-between">
          <div>
            <h3 class="font-serif text-2xl font-bold text-amber-100">Баланс сил в чате</h3>
            <p class="text-xs sm:text-sm text-amber-100/60 mt-1">Вклад каждого в нашу историю</p>
          </div>
          <div class="relative my-6 h-60 flex items-center justify-center">
            <canvas id="balanceChart"></canvas>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-3 border-t border-amber-500/15 text-center">
            <div class="p-2.5 rounded-2xl bg-amber-950/40 border border-amber-500/10">
              <span class="text-xs text-amber-200/70 block">Ваня</span>
              <span id="vanyaCountText" class="text-base font-bold text-amber-300">—</span>
            </div>
            <div class="p-2.5 rounded-2xl bg-amber-950/40 border border-amber-500/10">
              <span class="text-xs text-amber-200/70 block">Натка ❤️</span>
              <span id="natashaCountText" class="text-base font-bold text-orange-300">—</span>
            </div>
          </div>
        </div>

        <!-- График 2: Биоритмы -->
        <div class="reveal glass-card rounded-3xl p-6 sm:p-8 lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <h3 class="font-serif text-2xl font-bold text-amber-100">Биоритмы (00:00 – 23:00)</h3>
              <span id="peakHourBadge" class="text-xs px-2.5 py-1 rounded-full bg-orange-500/15 border border-orange-400/30 text-orange-300">Пик: 21:00</span>
            </div>
            <p class="text-xs sm:text-sm text-amber-100/60 mt-1">Часы, когда мы не можем оторваться от переписки</p>
          </div>
          <div class="relative mt-6 h-64 w-full">
            <canvas id="biorhythmChart"></canvas>
          </div>
        </div>

        <!-- График 3: Пульс отношений -->
        <div class="reveal glass-card rounded-3xl p-6 sm:p-8 lg:col-span-12">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">Пульс отношений</h3>
              <p class="text-xs sm:text-sm text-amber-100/60 mt-1">Кардиограмма нашей активности по дням</p>
            </div>
            <span id="peakDayBadge" class="text-xs px-3 py-1 rounded-full bg-amber-500/15 border border-amber-400/25 text-amber-200">Рекорд активности</span>
          </div>
          <div class="relative mt-6 h-72 w-full">
            <canvas id="pulseChart"></canvas>
          </div>
        </div>

        <!-- Словарь нашего чата -->
        <div class="reveal glass-card rounded-3xl p-6 sm:p-8 lg:col-span-12">
          <h3 class="font-serif text-2xl font-bold text-amber-100">Тепловая карта наших слов и фраз</h3>
          <p class="text-xs sm:text-sm text-amber-100/60 mt-1">Главные маркеры нашего общения, вытащенные из переписки</p>
          <div id="wordCloudContainer" class="mt-5 flex flex-wrap gap-2.5">
            <!-- Заполняется автоматически из JSON -->
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         3. ОБНОВЛЁННЫЙ ИНТЕРАКТИВНЫЙ ЗАЛ СЛАВЫ (8 КАРТОЧЕК)
         ========================================== -->
    <section id="hall" class="space-y-8">
      <div class="reveal text-center max-w-2xl mx-auto">
        <span class="text-xs uppercase tracking-widest text-amber-400/80 font-semibold">Ачивки наших 6 месяцев</span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-amber-50 mt-1">
          Интерактивный Зал Славы
        </h2>
        <p class="text-sm sm:text-base text-amber-100/65 mt-2">
          Наведи курсор или нажми на карточку, чтобы открыть историю каждого достижения
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Карта 1 -->
        <div class="reveal flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-3xl mb-3">🏆</div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">«Слава Наташе 🙏»</h3>
              <span class="mt-2 text-xs text-amber-300/60">Открыть историю ↻</span>
            </div>
            <div class="flip-card-back">
              <span class="text-2xl mb-2">⭐</span>
              <p class="text-sm font-medium text-amber-50 leading-relaxed">
                С чего всё начиналось: лучшая староста, которая вытянула первый семестр, сделала черчение за 15 минут и спасла оценки!
              </p>
            </div>
          </div>
        </div>

        <!-- Карта 2 (НОВАЯ взамен Hot Wheels) -->
        <div class="reveal flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-3xl mb-3">🧲</div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">Магнит за одной партой</h3>
              <span class="mt-2 text-xs text-amber-300/60">Открыть историю ↻</span>
            </div>
            <div class="flip-card-back">
              <span class="text-2xl mb-2">💫</span>
              <p class="text-sm font-medium text-amber-50 leading-relaxed">
                Секретные планы, как отсесть от всех на математике и физике, чтобы просто сидеть рядом и смеяться всю пару.
              </p>
            </div>
          </div>
        </div>

        <!-- Карта 3 (НОВАЯ взамен Букета 2027) -->
        <div class="reveal flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-3xl mb-3">🎁</div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">Артефакты нежности</h3>
              <span class="mt-2 text-xs text-amber-300/60">Открыть историю ↻</span>
            </div>
            <div class="flip-card-back">
              <span class="text-2xl mb-2">💐</span>
              <p class="text-sm font-medium text-amber-50 leading-relaxed">
                Любовь в деталях: от букетов и подарков, собранных своими руками, до заботы о каждом мелочном капризе друг друга.
              </p>
            </div>
          </div>
        </div>

        <!-- Карта 4 -->
        <div class="reveal flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-3xl mb-3">🎬</div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">Киноночи в обнимку</h3>
              <span class="mt-2 text-xs text-amber-300/60">Открыть историю ↻</span>
            </div>
            <div class="flip-card-back">
              <span class="text-2xl mb-2">🍿</span>
              <p class="text-sm font-medium text-amber-50 leading-relaxed">
                Совместные просмотры ужастиков, аниме и сериалов под пледом, когда весь остальной мир ставится на паузу.
              </p>
            </div>
          </div>
        </div>

        <!-- Карта 5 -->
        <div class="reveal flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-3xl mb-3">☕</div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">Вкусная забота</h3>
              <span class="mt-2 text-xs text-amber-300/60">Открыть историю ↻</span>
            </div>
            <div class="flip-card-back">
              <span class="text-2xl mb-2">🍙</span>
              <p class="text-sm font-medium text-amber-50 leading-relaxed">
                Спасительные перекусы в минуты голода, домашние вкусняшки, горячий кофе и умение вовремя накормить любимого человека.
              </p>
            </div>
          </div>
        </div>

        <!-- Карта 6 -->
        <div class="reveal flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-3xl mb-3">🌙</div>
              <h3 class="font-serif text-2xl font-bold text-amber-100">Ночной прайм-тайм</h3>
              <span class="mt-2 text-xs text-amber-300/60">Открыть историю ↻</span>
