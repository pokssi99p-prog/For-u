  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Встроенные данные из твоего прикрепленного result.json (включая реальную статистику войсов и сердечек)
      const FALLBACK_DATA = {
        total_messages: { "Ваня": 225, "Наташа": 195 },
        voice_seconds: 682,
        voice_count: 30,
        reactions_count: 25,
        messages_by_hour: {
          "0": 2, "1": 1, "6": 2, "7": 12, "8": 1, "9": 4, "10": 35, "11": 15,
          "12": 13, "13": 16, "14": 29, "15": 16, "16": 6, "17": 23, "18": 58,
