        },
        messages_by_day: {
          "2024-11-22": 18, "2024-12-03": 9, "2024-12-15": 13, "2024-12-18": 22,
          "2025-01-01": 12, "2025-02-02": 122, "2025-02-06": 66, "2025-02-09": 88,
          "2025-02-12": 103, "2025-02-14": 98, "2025-03-03": 52, "2025-04-25": 36
        },
        top_words: [
          ["спасибо ❤️", 28], ["математика", 24], ["завтра", 22], ["хорошо", 21],
          ["ахахах 😄", 39], ["оценки", 19], ["вместе", 15], ["информатика", 14],
          ["привет", 14], ["молодец", 11], ["черчение", 9], ["люблю 💛", 18]
        ]
      };

      let balanceChartInstance = null;
      let biorhythmChartInstance = null;
      let pulseChartInstance = null;

      Chart.defaults.color = 'rgba(253, 230, 138, 0.72)';
      Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";

      function showToast(text, icon = '✨') {
        const toast = document.getElementById('toastMessage');
        document.getElementById('toastText').textContent = text;
        document.getElementById('toastIcon').textContent = icon;
        toast.classList.remove('opacity-0', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-4');
        }, 3800);
      }

      function normalizeUserName(rawName) {
        if (!rawName) return null;
        const trimmed = String(rawName).trim();
        if (trimmed === 'Pokssi' || trimmed.toLowerCase().includes('ван') || trimmed.toLowerCase().includes('чистяков')) return 'Ваня';
        if (trimmed.includes('Натка') || trimmed.toLowerCase().includes('наташ')) return 'Наташа';
        return trimmed;
      }

      // Всеядный парсер JSON (понимает сырой result.json и считает войсы + сердечки + слова)
      function parseTelegramJSON(rawJson) {
        if (rawJson && Array.isArray(rawJson.messages)) {
          const totalByUser = { "Ваня": 0, "Наташа": 0 };
          const byHour = {};
          for (let h = 0; h < 24; h++) byHour[String(h)] = 0;
          const byDay = {};
          let voiceSeconds = 0;
          let voiceCount = 0;
          let reactionsCount = 0;
          const wordFreq = {};
          const stopWords = new Set(["это", "как", "так", "что", "мне", "там", "ещё", "уже", "или", "вот", "просто", "если", "меня", "тебе", "тебя", "будет", "надо", "только", "тоже", "было", "нет", "ну", "да", "не", "на", "по", "за", "из", "от", "до", "же", "бы", "то"]);

          rawJson.messages.forEach((msg) => {
            if (!msg || msg.type !== 'message' || !msg.from || !msg.date) return;
            const user = normalizeUserName(msg.from);
            if (user !== 'Ваня' && user !== 'Наташа') return;

            totalByUser[user] = (totalByUser[user] || 0) + 1;

            if (msg.media_type === 'voice_message' || msg.media_type === 'video_message') {
              voiceCount++;
              voiceSeconds += Number(msg.duration_seconds || 0);
            }

            if (Array.isArray(msg.reactions)) {
              msg.reactions.forEach(r => { reactionsCount += Number(r.count || 1); });
            }

            const dt = new Date(msg.date);
            if (!isNaN(dt.getTime())) {
              const hour = String(dt.getHours());
              byHour[hour] = (byHour[hour] || 0) + 1;
              const dayStr = msg.date.slice(0, 10);
              byDay[dayStr] = (byDay[dayStr] || 0) + 1;
            }

            const txt = typeof msg.text === 'string' ? msg.text : '';
            txt.toLowerCase().replace(/[^а-яёa-z\s]/g, ' ').split(/\s+/).forEach(w => {
              if (w.length >= 4 && !stopWords.has(w)) {
                wordFreq[w] = (wordFreq[w] || 0) + 1;
              }
            });
          });

          const sortedDays = {};
          Object.keys(byDay).sort().forEach(d => { sortedDays[d] = byDay[d]; });
          const topWords = Object.entries(wordFreq).sort((a, b) => b[1] - a[1]).slice(0, 14);

          return {
            total_messages: totalByUser,
            voice_seconds: voiceSeconds,
            voice_count: voiceCount,
            reactions_count: reactionsCount,
            messages_by_hour: byHour,
            messages_by_day: sortedDays,
            top_words: topWords.length ? topWords : FALLBACK_DATA.top_words
          };
        }
        return { ...FALLBACK_DATA, ...rawJson };
      }

      // Парсер для пачки HTML файлов (messages1.html ... messages60.html) прямо в браузере
      async function parseMultipleHTMLFiles(files) {
        const totalByUser = { "Ваня": 0, "Наташа": 0 };
        const byHour = {};
        for (let h = 0; h < 24; h++) byHour[String(h)] = 0;
        const byDay = {};
        let voiceCount = 0;
        let lastSender = 'Ваня';

        const parser = new DOMParser();
        for (const file of files) {
          const text = await file.text();
          const doc = parser.parseFromString(text, 'text/html');
          const msgs = doc.querySelectorAll('.message.default');
          msgs.forEach(m => {
            const fromEl = m.querySelector('.from_name');
            if (fromEl) lastSender = normalizeUserName(fromEl.textContent) || lastSender;
            if (lastSender === 'Ваня' || lastSender === 'Наташа') {
              totalByUser[lastSender] = (totalByUser[lastSender] || 0) + 1;
            }
            if (m.querySelector('.media_voice_message')) voiceCount++;
            const dateEl = m.querySelector('.pull_right.date.details');
            if (dateEl && dateEl.getAttribute('title')) {
              const title = dateEl.getAttribute('title'); // DD.MM.YYYY HH:MM:SS
              const parts = title.split(' ');
              if (parts.length >= 2) {
                const dParts = parts[0].split('.');
                const tParts = parts[1].split(':');
                if (dParts.length === 3 && tParts.length >= 2) {
                  const isoDay = `${dParts[2]}-${dParts[1]}-${dParts[0]}`;
                  byDay[isoDay] = (byDay[isoDay] || 0) + 1;
                  const hr = String( parseInt(tParts[0], 10) );
                  byHour[hr] = (byHour[hr] || 0) + 1;
                }
              }
            }
          });
        }
        const sortedDays = {};
        Object.keys(byDay).sort().forEach(d => { sortedDays[d] = byDay[d]; });
        return {
          total_messages: totalByUser,
          voice_seconds: voiceCount * 18,
          voice_count: voiceCount,
          reactions_count: Math.round((totalByUser["Ваня"] + totalByUser["Наташа"]) * 0.08),
          messages_by_hour: byHour,
          messages_by_day: sortedDays,
          top_words: FALLBACK_DATA.top_words
        };
      }

      function animateCounter(elementId, targetValue, duration = 1600) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const startTime = performance.now();
        function update(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 4);
          el.textContent = Math.round(targetValue * eased).toLocaleString('ru-RU');
          if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
      }

      function renderDashboard(data, sourceLabel) {
        document.getElementById('dataSourceText').textContent = sourceLabel;
        const vanyaCount = Number(data.total_messages['Ваня'] || 0);
        const natashaCount = Number(data.total_messages['Наташа'] || 0);
        const totalMessages = vanyaCount + natashaCount;

        animateCounter('messagesCounter', totalMessages);
        animateCounter('voiceMinutesCounter', Math.max(1, Math.round((data.voice_seconds || 680) / 60)));
        animateCounter('reactionsCounter', data.reactions_count || 25);

        document.getElementById('vanyaCountText').textContent = `${vanyaCount.toLocaleString('ru-RU')} сообщ.`;
        document.getElementById('natashaCountText').textContent = `${natashaCount.toLocaleString('ru-RU')} сообщ.`;

        // Словарь
        const wc = document.getElementById('wordCloudContainer');
        wc.innerHTML = '';
        (data.top_words || FALLBACK_DATA.top_words).forEach(([word, count]) => {
          const badge = document.createElement('span');
          badge.className = 'px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/25 text-amber-100 text-xs sm:text-sm flex items-center gap-2';
          badge.innerHTML = `<span>${word}</span><span class="text-amber-400 font-bold">${count}</span>`;
          wc.appendChild(badge);
        });

        // Doughnut
        const ctx1 = document.getElementById('balanceChart').getContext('2d');
        if (balanceChartInstance) balanceChartInstance.destroy();
        balanceChartInstance = new Chart(ctx1, {
          type: 'doughnut',
          data: {
            labels: ['Ваня', 'Наташа'],
            datasets: [{
              data: [vanyaCount, natashaCount],
              backgroundColor: ['#fbbf24', '#f97316'],
              borderColor: '#160d09',
              borderWidth: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: { legend: { position: 'bottom', labels: { color: '#fde68a' } } }
          }
        });

        // Bar
        const ctx2 = document.getElementById('biorhythmChart').getContext('2d');
        const hourLabels = Array.from({ length: 24 }, (_, i) => `${String(i).padStart(2, '0')}:00`);
        const hourValues = Array.from({ length: 24 }, (_, i) => Number(data.messages_by_hour[String(i)] || 0));
        let maxH = 0;
        hourValues.forEach((v, i) => { if (v > hourValues[maxH]) maxH = i; });
        document.getElementById('peakHourBadge').textContent = `Пик: ${String(maxH).padStart(2, '0')}:00`;

        if (biorhythmChartInstance) biorhythmChartInstance.destroy();
        biorhythmChartInstance = new Chart(ctx2, {
          type: 'bar',
          data: {
            labels: hourLabels,
            datasets: [{ data: hourValues, backgroundColor: '#fbbf24', borderRadius: 6 }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { grid: { display: false }, ticks: { color: '#fde68a99', maxTicksLimit: 8 } },
              y: { grid: { color: 'rgba(251, 191, 36, 0.08)' }, ticks: { color: '#fde68a99' } }
            },
            plugins: { legend: { display: false } }
          }
        });

        // Line
        const ctx3 = document.getElementById('pulseChart').getContext('2d');
        const dayEntries = Object.entries(data.messages_by_day || {});
        if (pulseChartInstance) pulseChartInstance.destroy();
        pulseChartInstance = new Chart(ctx3, {
          type: 'line',
          data: {
            labels: dayEntries.map(([d]) => d),
            datasets: [{
              data: dayEntries.map(([, c]) => Number(c)),
              borderColor: '#fbbf24',
              backgroundColor: 'rgba(245, 158, 11, 0.2)',
              fill: true,
              tension: 0.4,
              pointRadius: 3
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: { grid: { display: false }, ticks: { color: '#fde68a99', maxTicksLimit: 8 } },
              y: { grid: { color: 'rgba(251, 191, 36, 0.08)' }, ticks: { color: '#fde68a99' } }
            },
            plugins: { legend: { display: false } }
          }
        });
      }

      // Обработчик загрузки JSON или пачки HTML файлов
      document.getElementById('fileInput').addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        if (files[0].name.endsWith('.json')) {
          const text = await files[0].text();
          renderDashboard(parseTelegramJSON(JSON.parse(text)), files[0].name);
          showToast(`Загружен JSON: ${files[0].name}`, '💛');
        } else {
          const aggregated = await parseMultipleHTMLFiles(files);
          renderDashboard(aggregated, `Собрано файлов: ${files.length}`);
          showToast(`Обработано ${files.length} HTML-файлов чата!`, '🔥');
        }
      });

      // 2. Логика блока «После полуночи 🕯️» (3 уровня близости)
      const INTIMACY_DECK = {
        1: [
          "«Какое прикосновение (к шее, спине, волосам или рукам) мгновенно вызывает у тебя мурашки и заставляет забыть обо всём?»",
          "«В какой момент рядом со мной ты чувствуешь себя максимально желанной, красивой и защищённой?»",
          "«Какие объятия ты любишь больше: долгие в полной тишине под пледом или внезапные крепкие со спины?»",
          "«Какой запах или деталь во мне притягивает тебя сильнее всего, когда мы близко?»",
          "«Что для тебя идеальная прелюдия к вечеру вдвоём: массаж, тёплый душ вместе или долгие поцелуи в полумраке?»"
        ],
        2: [
          "«В какой одежде (или без неё) я кажусь тебе самым горячим и привлекательным?»",
          "«Какой наш поцелуй или интимный момент за эти полгода запомнился тебе ярче всего?»",
          "«Что заводит тебя быстрее: шёпот на ухо, медленные прикосновения на грани или уверенный взгляд глаза в глаза?»",
          "«Какая атмосфера в комнате включает твоё желание на максимум: приглушённый тёплый свет, музыка или полная темнота?»",
          "«Если бы прямо сейчас мы могли телепортироваться в любое место только вдвоём на всю ночь — где бы мы оказались?»"
        ],
        3: [
          "«Есть ли тайное желание или ласка, которую тебе очень хочется попробовать со мной, но ты стеснялась сказать первой?»",
          "«Где и как тебе больше всего нравится, когда я тебя целую и прикасаюсь, когда мы остаёмся совсем одни?»",
          "«Что в близости со мной дарит тебе самые сильные эмоции: нежная медленная чувственность или страсть и напор?»",
          "«Какой сигнал без слов выдает, что ты очень хочешь меня прямо сейчас?»",
          "«Давай загадаем одно общее интимное желание на эту ночь — и исполним его сразу после того, как досмотрим сайт.»"
        ]
      };
      let currentLevel = 1;
      let currentQIdx = 0;

      function updateIntimacyCard() {
        const list = INTIMACY_DECK[currentLevel];
        document.getElementById('intimacyBadge').textContent = `Уровень ${currentLevel} • Вопрос ${currentQIdx + 1} из ${list.length}`;
        document.getElementById('intimacyQuestionText').textContent = list[currentQIdx];
      }

      document.querySelectorAll('.intimacy-lvl-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.intimacy-lvl-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentLevel = Number(btn.dataset.level);
          currentQIdx = 0;
          updateIntimacyCard();
        });
      });

      document.getElementById('nextIntimacyBtn').addEventListener('click', () => {
        const list = INTIMACY_DECK[currentLevel];
        currentQIdx = (currentQIdx + 1) % list.length;
        updateIntimacyCard();
      });
      document.getElementById('prevIntimacyBtn').addEventListener('click', () => {
        const list = INTIMACY_DECK[currentLevel];
        currentQIdx = (currentQIdx - 1 + list.length) % list.length;
        updateIntimacyCard();
      });

      // 3. Конструктор будущего (Квартира и питомец)
      let selectedFlat = localStorage.getItem('vn_flat') || 'Тёплый лофт с панорамным видом и мягкой подсветкой';
      let selectedPet = localStorage.getItem('vn_pet') || 'Чёрный харизматичный кот-философ 🐈‍⬛';

      function updateFutureSummary() {
        document.getElementById('futureSummaryText').textContent = `«${selectedFlat} + ${selectedPet}»`;
        localStorage.setItem('vn_flat', selectedFlat);
        localStorage.setItem('vn_pet', selectedPet);
      }

      document.querySelectorAll('.flat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.flat-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedFlat = btn.dataset.val;
          updateFutureSummary();
          showToast('Выбор квартиры сохранён в капсулу!', '🏡');
        });
      });

      document.querySelectorAll('.pet-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.pet-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedPet = btn.dataset.val;
          updateFutureSummary();
          showToast('Будущий питомец выбран!', '🐾');
        });
      });
      updateFutureSummary();

      // 4. Игра «Синхронизация»
      const SYNC_QUESTIONS = [
        "Кто быстрее засыпает во время вечернего просмотра фильма?",
        "Кто первым идёт мириться или обниматься после мелкой бурчалки?",
        "Кто генерирует больше спонтанных безумных идей на вечер?",
        "Кто чаще отвечает за запасы вкусной еды и перекусов?",
        "Кто дольше собирается перед выходом из дома?",
        "Кто больше любит тактильные обнимашки без повода 24/7?"
      ];
      let syncIdx = 0;
      document.querySelectorAll('.sync-ans-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const who = btn.dataset.who;
          document.getElementById('syncVerdict').textContent = `Зафиксировано: ${who}! Переходим к следующему...`;
          setTimeout(() => {
            syncIdx = (syncIdx + 1) % SYNC_QUESTIONS.length;
            document.getElementById('syncStepBadge').textContent = `Раунд ${syncIdx + 1} из ${SYNC_QUESTIONS.length}`;
            document.getElementById('syncQuestion').textContent = SYNC_QUESTIONS[syncIdx];
            document.getElementById('syncVerdict').textContent = '';
          }, 900);
        });
      });

      // 5. Кликер уюта
      let clicks = 0;
      const quotes = [
        "«Натка рядом — и весь мир в порядке ❤️»",
        "«Твоя забота — лучший антистресс в мире»",
        "«Спасибо за твоё тепло, нежность и поддержку ✨»",
        "«Самое уютное место на земле — в твоих объятиях»"
      ];
      document.getElementById('heartBtn').addEventListener('click', () => {
        clicks += 5;
        document.getElementById('clickCount').textContent = clicks;
        document.getElementById('clickQuote').textContent = quotes[(clicks / 5) % quotes.length];
      });

      // 6. Чек-лист свиданий (Bucket List)
      const BUCKET_ITEMS = [
        { id: 1, text: "Пережить первый семестр и закрыть все зачёты вместе", done: true },
        { id: 2, text: "Отметить наши первые 6 месяцев отношений ❤️", done: true },
        { id: 3, text: "Устроить марафон любимых фильмов под пледом до утра", done: false },
        { id: 4, text: "Поехать вдвоём в красивое место на природу / в горы с ночёвкой", done: false },
        { id: 5, text: "Приготовить вместе ужин мечты под музыку и свечи", done: false },
        { id: 6, text: "Сходить на парный творческий мастер-класс или квест", done: false },
        { id: 7, text: "Сделать большую серию тёплых совместных фотографий", done: false },
        { id: 8, text: "Выбрать нашу уютную квартиру и завести питомца 🐾", done: false }
      ];

      function renderBucketList() {
        const container = document.getElementById('bucketListContainer');
        container.innerHTML = '';
        let doneCount = 0;
        BUCKET_ITEMS.forEach(item => {
          if (item.done) doneCount++;
          const btn = document.createElement('button');
          btn.className = `p-4 rounded-2xl glass-card text-left flex items-center gap-3 transition ${item.done ? 'border-amber-400/50 bg-amber-500/15' : 'opacity-80'}`;
          btn.innerHTML = `
            <span class="w-6 h-6 rounded-full flex items-center justify-center border ${item.done ? 'bg-amber-400 text-stone-950 border-amber-300 font-bold' : 'border-amber-400/40 text-transparent'}">✓</span>
            <span class="text-xs sm:text-sm ${item.done ? 'line-through text-amber-200/70' : 'text-amber-50'}">${item.text}</span>
          `;
          btn.addEventListener('click', () => {
            item.done = !item.done;
            renderBucketList();
          });
          container.appendChild(btn);
        });
        const pct = Math.round((doneCount / BUCKET_ITEMS.length) * 100);
        document.getElementById('bucketProgressText').textContent = `${doneCount} из ${BUCKET_ITEMS.length} выполнено (${pct}%)`;
        document.getElementById('bucketProgressBar').style.width = `${pct}%`;
      }
      renderBucketList();

      // Flip cards
      document.querySelectorAll('.flip-card').forEach(card => {
        card.addEventListener('click', () => card.classList.toggle('is-flipped'));
      });

      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      // Инициализация
      renderDashboard(FALLBACK_DATA, 'Архив чата (Встроенный)');
    });
  </script>
</body>
</html>
